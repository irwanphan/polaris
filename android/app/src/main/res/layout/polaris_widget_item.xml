<?xml version="1.0" encoding="utf-8"?>
<!--
  Single row in the Polaris widget ListView. Populated by
  PolarisWidgetItemsFactory#getViewAt.

  Palette (light surface variant):
   * title    — slate-500 (#64748B), small caps-ish header
   * hero     — slate-900 (#0F172A), the at-a-glance number
   * subtitle — slate-500 (#64748B), 11sp body line

  Background is intentionally transparent (see
  polaris_widget_item_background.xml) — the outer double frame in
  polaris_widget_background.xml already provides the "card"
  affordance, so per-row backgrounds would compete with it. Row
  separation comes from vertical padding + the colored accent
  strip on the left.

  All IDs are referenced from
  android/app/src/main/kotlin/com/phandarian/polaris/PolarisWidgetItemsFactory.kt —
  keep in sync when renaming.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/polaris_widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="@drawable/polaris_widget_item_background">

    <!--
      FrameLayout (not View) because raw `android.view.View` is not
      on the RemoteViews allowed-class list — inflating it crashes
      the launcher with "Class not allowed to be inflated". The
      backgroundColor is overridden per-row from
      PolarisWidgetItemsFactory via
      `RemoteViews#setInt(..., "setBackgroundColor", color)`.
    -->
    <FrameLayout
        android:id="@+id/polaris_widget_item_accent"
        android:layout_width="4dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/polaris_widget_accent_strip" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/polaris_widget_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Title" />

        <TextView
            android:id="@+id/polaris_widget_item_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="—" />

        <TextView
            android:id="@+id/polaris_widget_item_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Subtitle" />
    </LinearLayout>
</LinearLayout>
