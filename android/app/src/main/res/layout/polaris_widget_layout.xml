<?xml version="1.0" encoding="utf-8"?>
<!--
  RemoteViews layout for the Polaris home-screen collection widget.

  Structure:
    * Header   — app title ("Polaris") + amber brand pill. Tappable
                 to launch the app.
    * ListView — scrollable list of pinned subjects (life countdown
                 first, then events sorted by target date). Each row
                 is inflated from polaris_widget_item.xml by
                 PolarisWidgetItemsFactory.
    * Empty    — shown by RemoteViews when the list is empty (no
                 pins yet). Wired via setEmptyView in the provider.

  Design tokens (must mirror lib/app/theme/color_tokens.dart):
  - Surface:   Indigo 700 (#4338CA) with 20dp rounded corners.
  - Title:     White, 14sp, bold.
  - Brand pill Amber 400 (#FBBF24) "POLARIS" badge.

  IDs are referenced by name in PolarisWidgetProvider.kt — keep in
  sync when renaming.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/polaris_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/polaris_widget_background">

    <LinearLayout
        android:id="@+id/polaris_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/polaris_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Polaris" />

        <TextView
            android:id="@+id/polaris_widget_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="#0F172A"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/polaris_widget_brand_pill"
            android:text="POLARIS" />
    </LinearLayout>

    <ListView
        android:id="@+id/polaris_widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent" />

    <LinearLayout
        android:id="@+id/polaris_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/polaris_widget_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="Nothing pinned yet" />

        <TextView
            android:id="@+id/polaris_widget_empty_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#C7D2FE"
            android:textSize="12sp"
            android:gravity="center"
            android:text="Pin from inside Polaris" />
    </LinearLayout>
</LinearLayout>
