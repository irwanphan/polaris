<?xml version="1.0" encoding="utf-8"?>
<!--
  RemoteViews layout for the Polaris home-screen collection widget.

  Structure:
    * Header   — app title ("Polaris") + amber brand pill. Tappable
                 to launch the app.
    * ListView — scrollable list of pinned subjects (life countdown
                 first, then events sorted by target date). Each row
                 is inflated from polaris_widget_item.xml by
                 PolarisWidgetItemsFactory.
    * Empty    — shown by RemoteViews when the list is empty (no
                 pins yet). Wired via setEmptyView in the provider.

  Palette (light surface variant):
  - Surface:   `polaris_widget_background.xml` — cyan-50 fill with
               a single thick black "ticket" border. Drives the
               dark-on-light text choice.
  - Title:     slate-900 (#0F172A), 14sp, bold.
  - Brand pill amber #FBBF24 with slate-900 text — kept warm so it
               still reads as a brand stamp, not a label.
  - Padding is asymmetric: 18dp on left / right / top so the
               outer black frame has room to breathe before the
               first content row, but **0dp at the bottom** so
               the last item pill can ride flush against the
               bottom of the cyan card. Each row already carries
               a 5dp bottom shadow inside its own pill, which
               supplies the visual "exit margin" the cyan card
               would otherwise need.

  Typography:
  - Every TextView declares `android:fontFamily="@font/montserrat"`
    to mirror the Flutter app's brand font. Resource fonts in
    RemoteViews require API 26+; Android 5–7 launchers silently
    fall back to the system default, which is fine.

  IDs are referenced by name in PolarisWidgetProvider.kt — keep in
  sync when renaming.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/polaris_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:paddingTop="18dp"
    android:paddingBottom="0dp"
    android:background="@drawable/polaris_widget_background">

    <LinearLayout
        android:id="@+id/polaris_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/polaris_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/montserrat"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Polaris" />

        <TextView
            android:id="@+id/polaris_widget_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:fontFamily="@font/montserrat"
            android:textColor="#0F172A"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/polaris_widget_brand_pill"
            android:text="POLARIS" />
    </LinearLayout>

    <!--
      ListView caveats wired via XML (RemoteViews-safe attributes):
       * `fadingEdgeLength=0` + `requiresFadingEdge=none` — the
         default vertical ListView fades the top edge of the
         first visible row to hint "more content above". On our
         neobrutalist pill the top frame is only 2dp tall, so
         the fade swallows the entire black border and makes it
         look "cut off". Disabling the fade keeps the border
         crisp top to bottom.
       * `overScrollMode=never` — kills the iOS-style elastic
         glow when the user drags past the first/last row,
         which would otherwise bleed amber+black through the
         outer cyan card and look broken.
       * `divider=null` / `dividerHeight=0dp` — row gap comes
         from `marginBottom` on the row, not from a divider.
    -->
    <ListView
        android:id="@+id/polaris_widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:fadingEdgeLength="0dp"
        android:requiresFadingEdge="none"
        android:overScrollMode="never"
        android:listSelector="@android:color/transparent" />

    <LinearLayout
        android:id="@+id/polaris_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/polaris_widget_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="Nothing pinned yet" />

        <TextView
            android:id="@+id/polaris_widget_empty_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserrat"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:gravity="center"
            android:text="Pin from inside Polaris" />
    </LinearLayout>
</LinearLayout>
