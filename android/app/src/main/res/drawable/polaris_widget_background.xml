<?xml version="1.0" encoding="utf-8"?>
<!--
  Polaris widget surface: cyan-50 (#ECFEFF) card framed by a
  single thick black outer ring. Earlier revisions also had a
  thin inner hairline a few dp inside the outer ring, but that
  competes visually with the per-row pill outlines below — the
  hairline has been removed in favor of a single, confident frame.

  Background color is the sRGB approximation of the design spec
  `oklch(98.4% 0.019 200.873)`. Adjust the hex if a stricter
  match is needed — Android drawables do not understand OKLCH
  natively.

  Layer order (bottom → top):
   1. Solid black with the widget's outer corner radius — paints
      the OUTER ring; the layer above masks it.
   2. Cyan-50 fill, inset 6dp on every side — this is the actual
      surface the content sits on. Inset = stroke thickness.

  Tweak knobs:
   * Outer stroke thickness  → first item corners.radius vs the
     second item's inset.
   * Frame color             → solid color in item 1.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F172A" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#ECFEFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
