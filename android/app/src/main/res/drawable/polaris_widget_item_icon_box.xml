<?xml version="1.0" encoding="utf-8"?>
<!--
  Square icon container that lives at the leading edge of every row
  in `polaris_widget_item.xml`. The fill (amber-500, #F59E0B) sits
  one shade darker than the surrounding pill (amber-400, #FBBF24)
  so the icon-box reads as a separate "stamp" without needing a
  border of its own.

  Corner radius is intentionally smaller than the outer pill's so
  the two curves stay visually nested rather than concentric — the
  pill feels like the parent shape, the icon-box like a child.

  This drawable is *static* (no per-row tinting from
  `PolarisWidgetItemsFactory.kt`). RemoteViews cannot dynamically
  tint a shape drawable on API < 31 without losing the corner
  radius — `setInt(..., "setBackgroundColor", ...)` replaces the
  whole drawable with a flat color. The previous per-row accent
  hex from the JSON contract is therefore preserved on disk but
  intentionally not rendered. Reintroduce via emoji or a small
  trailing dot if needed.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F59E0B" />
    <corners android:radius="10dp" />
</shape>
